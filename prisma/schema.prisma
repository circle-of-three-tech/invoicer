// Prisma schema for the CO3 invoice generator.
// Dates are stored as ISO strings to mirror the app's existing string-based
// model in src/lib/types.ts, keeping the DB layer a thin, lossless mirror.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id          String  @id @default("default")
  name        String
  email       String
  phone       String
  address     String
  taxId       String  @default("")
  currency    String  @default("USD")
  accent      String  @default("iris")

  // The logo is a base64 data URL up to 256 KB. It is deliberately NOT part of
  // the workspace snapshot: `logoVersion` (a content hash) travels instead, and
  // the bytes are fetched once from GET /api/logo and cached by the browser.
  logoDataUrl String?
  logoVersion String?

  // How clients are told to pay. Ordered, and owned by the profile, so the
  // whole set is replaced in one transaction when Settings is saved.
  paymentDetails PaymentDetail[]
}

/// A single way to be paid — a bank account, a payment link, a wallet.
model PaymentDetail {
  id        String  @id
  companyId String
  label     String
  kind      String  @default("other") // bank | link | mobile | crypto | other
  details   String  @default("")
  url       String  @default("")
  enabled   Boolean @default(true)
  position  Int     @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, position])
}

model Invoice {
  id     String @id
  number String @unique
  status String // "draft" | "sent" | "paid"

  issueDate String
  dueDate   String
  currency  String

  fromName    String
  fromEmail   String
  fromAddress String
  fromPhone   String

  toName    String
  toEmail   String
  toAddress String
  toPhone   String

  taxRate  Float @default(0)
  discount Float @default(0)
  notes    String @default("")
  accent   String

  createdAt String
  paidAt    String?
  receiptId String?
  sentAt    String?

  items LineItem[]

  @@index([createdAt])
}

model LineItem {
  id          String @id
  invoiceId   String
  description String @default("")
  quantity    Float  @default(1)
  rate        Float  @default(0)
  position    Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Receipt {
  id            String @id
  number        String @unique
  invoiceId     String
  invoiceNumber String
  amount        Float
  currency      String
  method        String
  reference     String @default("")
  paidAt        String

  fromName    String
  fromEmail   String
  fromAddress String
  fromPhone   String

  toName    String
  toEmail   String
  toAddress String
  toPhone   String

  createdAt String
  sentAt    String?

  @@index([invoiceId])
  @@index([createdAt])
}
