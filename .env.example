# ---------------------------------------------------------------------------
# Database (Prisma Postgres / any Postgres)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Per-instance connection pool size. Keep this small: many warm serverless
# instances share one Postgres connection limit.
# DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------------
# Authentication (REQUIRED in production — the app refuses to run without them)
# ---------------------------------------------------------------------------
# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# The shared passphrase that unlocks the workspace.
APP_PASSWORD=""

# Stable across instances so encrypted Server Action closures stay valid on
# multi-instance deployments. Generate with: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Email (Nodemailer SMTP) — optional; sending is disabled if unset
# ---------------------------------------------------------------------------
# Gmail example: host=smtp.gmail.com, port=587, pass=<16-char app password>
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Leave unset to infer from the port (465 = implicit TLS).
SMTP_SECURE=""
# The visible From address. Defaults to SMTP_USER.
MAIL_FROM=""

# ---------------------------------------------------------------------------
# Demo data — leave unset on any deployment holding real invoices.
# When "true", the Settings page can wipe the database and reinstate samples.
# ---------------------------------------------------------------------------
# ALLOW_DEMO_DATA="false"
